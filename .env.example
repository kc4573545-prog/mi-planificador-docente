# Copia este archivo a .env para desarrollo local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planificador
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
PORT=3000
# true si tu Postgres exige SSL (p. ej. URL externa de Render)
PGSSL=false
# Opcional: solo si el frontend se sirve desde otro origen
# CORS_ORIGIN=https://tu-dominio.com
